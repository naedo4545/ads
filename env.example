# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key

# PaddleOCR Configuration (if using local model)
PADDLEOCR_MODEL_PATH=./models/paddleocr

# Whisper Configuration (if using local model)
WHISPER_MODEL_PATH=./models/whisper

# Crawler Configuration
CRAWLER_DELAY=1000
CRAWLER_MAX_PAGES=100
CRAWLER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# AI Worker Configuration
AI_WORKER_BATCH_SIZE=10
AI_WORKER_DELAY=5000
